# Whitelist: only the bank posting module and what it needs is tracked.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/config.example.ini
!/config.ini
!/logger_setup.py
!/db_manager.py
!/sap_odata_extractor.py
!/main.py
!/api.py
!/bank_posting/
!/.vscode/
!/Dockerfile
!/.dockerignore
!/buildspec.yml
!/deploy/
!/DEPLOYMENT_PLAN.md

# never commit
.env
__pycache__/
*.pyc
log/
