# Whitelist: only the bank posting module and what it needs is tracked.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/config.example.ini
!/logger_setup.py
!/db_manager.py
!/sap_odata_extractor.py
!/main.py
!/api.py
!/bank_posting/
!/.vscode/
!/Dockerfile
!/.dockerignore
!/buildspec.yml
!/deploy/
!/DEPLOYMENT_PLAN.md
# SAP extraction service (separate deployment, see sap-extraction-api/docs/DEPLOYMENT.md)
!/sap-extraction-api/

# never commit (passwords, API keys): config.ini lives in SSM /sap-bank-clearing-api/config.ini
/config.ini
/config.ini.bak_*
/sap-extraction-api/config.ini
/sap-extraction-api/**/*.bak_*
/sap-extraction-api/data/
/sap-extraction-api/dist/
/sap-extraction-api/.venv/
.env
__pycache__/
*.pyc
log/
