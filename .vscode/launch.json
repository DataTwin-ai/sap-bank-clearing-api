{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI: Run main.py (Uvicorn)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "main:app",
                "--reload",
                "--port",
                "8000"
            ],
            "jinja": true,
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "FastAPI: Run main.py (Direct)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": [
                "--port",
                "8000"
            ],
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "FastAPI: Standalone server.py (Port 8001)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/bank_posting/server.py",
            "args": [
                "--port",
                "8001"
            ],
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Bank Posting: CLI Dry Run",
            "type": "debugpy",
            "request": "launch",
            "module": "bank_posting.posting",
            "args": [
                "C:\\SAP\\log\\BANK EXCEL SHEET.xlsx",
                "--dry-run"
            ],
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}
