{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "ReadConfig", "Effect": "Allow", "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:us-east-1:203456943124:parameter/sap-bank-clearing-api/*" },
    { "Sid": "DecryptConfig", "Effect": "Allow", "Action": "kms:Decrypt", "Resource": "*",
      "Condition": { "StringEquals": { "kms:ViaService": "ssm.us-east-1.amazonaws.com" } } }
  ]
}
